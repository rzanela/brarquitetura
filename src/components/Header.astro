---
import { Image } from 'astro:assets';
import { siteData } from '../data/site';
import { getRelativeUrl } from '../utils/url';
import { confirmed } from '../utils/pending';
import logo from '../assets/marca/logo-borges-robles.png';
import logoBranca from '../assets/marca/logo-borges-robles-branca.png';

interface Props {
  currentPath?: string;
  transparentOverHero?: boolean;
}

const { currentPath = Astro.url.pathname, transparentOverHero = false } = Astro.props;

const navItems = [
  { label: 'Projetos', href: getRelativeUrl('/projetos/') },
  { label: 'Escritório', href: getRelativeUrl('/escritorio/') },
  { label: 'Contato', href: getRelativeUrl('/contato/') }
];

const coordinates = confirmed(siteData.geo.displayCoordinates);
---

<header class:list={['site-header', { 'header-transparent': transparentOverHero }]} id="site-header">
  <div class="container header-inner">
    <!-- Logo oficial -->
    <a href={getRelativeUrl('/')} class="wordmark" aria-label="Borges e Robles Arquitetura — Página Inicial">
      <Image
        src={logo}
        alt="Borges e Robles Arquitetura"
        widths={[240, 480, 960]}
        sizes="(max-width: 767px) 176px, 220px"
        class="wordmark-logo wordmark-logo--escura"
        loading="eager"
        decoding="async"
      />
      {transparentOverHero && (
        <Image
          src={logoBranca}
          alt=""
          aria-hidden="true"
          widths={[240, 480, 960]}
          sizes="(max-width: 767px) 176px, 220px"
          class="wordmark-logo wordmark-logo--branca"
          loading="eager"
          decoding="async"
        />
      )}
    </a>

    <!-- Navegação Desktop -->
    <nav class="nav-desktop" aria-label="Navegação principal">
      <ul class="nav-list">
        {navItems.map((item) => (
          <li>
            <a 
              href={item.href} 
              class:list={['nav-link', { 'is-active': currentPath.startsWith(item.href) }]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Botão Menu Mobile (Texto sóbrio, anti-cara-de-IA: sem ícone de 3 risquinhos) -->
    <button 
      type="button" 
      class="mobile-menu-trigger" 
      data-menu-toggle 
      aria-expanded="false" 
      aria-controls="mobile-overlay"
      aria-label="Abrir menu de navegação"
    >
      Menu
    </button>
  </div>

  <!-- Overlay Mobile em tela cheia -->
  <div id="mobile-overlay" class="mobile-overlay" data-menu-overlay aria-hidden="true">
    <div class="mobile-overlay-inner container">
      <div class="mobile-overlay-header">
        <span class="type-mono-label">Navegação</span>
      </div>
      <nav class="mobile-nav" aria-label="Navegação mobile">
        <ul class="mobile-nav-list">
          <li>
            <a href={getRelativeUrl('/')} class="mobile-nav-link">Início</a>
          </li>
          {navItems.map((item) => (
            <li>
              <a href={item.href} class="mobile-nav-link">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="mobile-overlay-footer hairline-top">
        <p class="type-mono-label">{siteData.address.fullFormatted}</p>
        {coordinates && <p class="type-mono-label">{coordinates}</p>}
      </div>
    </div>
  </div>
</header>

<script>
  import { initMenu } from '../scripts/menu';

  // O ClientRouter troca o <header> a cada navegação: menu e rolagem precisam
  // ser religados ao novo elemento em toda página (astro:page-load), e os
  // ouvintes da página anterior são descartados via AbortController.
  let controller: AbortController | null = null;

  document.addEventListener('astro:page-load', () => {
    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;

    initMenu(signal);

    // Header vira --paper com fio de 1px ao rolar
    const header = document.getElementById('site-header');
    const handleScroll = () => {
      header?.classList.toggle('is-scrolled', window.scrollY > 20);
    };
    window.addEventListener('scroll', handleScroll, { passive: true, signal });
    handleScroll();
  });
</script>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    height: var(--header-height);
    background-color: var(--paper);
    border-bottom: 1px solid var(--line);
    transition: background-color var(--motion-duration-fast) ease, border-color var(--motion-duration-fast) ease;
  }

  .site-header.header-transparent:not(.is-scrolled) {
    background-color: transparent;
    border-bottom: 1px solid transparent;
  }

  /* Sobre a fotografia do hero: texto claro + véu escuro no topo para legibilidade.
     Desliga quando o menu mobile (fundo --paper) está aberto. */
  .site-header.header-transparent:not(.is-scrolled):not(:has(.mobile-overlay.is-open)) {
    background-image: linear-gradient(to bottom, rgba(14, 18, 24, 0.55), rgba(14, 18, 24, 0));
  }

  .site-header.header-transparent:not(.is-scrolled):not(:has(.mobile-overlay.is-open))
    :is(.nav-link, .mobile-menu-trigger) {
    color: #F5F6F7;
  }

  /* Sobre a fotografia: troca para a versão branca oficial da logo (barras azuis mantidas) */
  .site-header.header-transparent:not(.is-scrolled):not(:has(.mobile-overlay.is-open)) .wordmark-logo--escura {
    display: none;
  }

  .site-header.header-transparent:not(.is-scrolled):not(:has(.mobile-overlay.is-open)) .wordmark-logo--branca {
    display: block;
  }

  .site-header.header-transparent:not(.is-scrolled):not(:has(.mobile-overlay.is-open)) .mobile-menu-trigger {
    border-bottom-color: #F5F6F7;
  }


  .header-inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* Logo */
  .wordmark {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  .wordmark-logo {
    display: block;
    height: 30px;
    width: auto;
  }

  .wordmark-logo--branca {
    display: none;
  }

  @media (max-width: 767px) {
    .wordmark-logo {
      height: 24px;
    }
  }

  /* Desktop Nav */
  .nav-desktop {
    display: none;
  }

  @media (min-width: 768px) {
    .nav-desktop {
      display: block;
    }
    .mobile-menu-trigger {
      display: none;
    }
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 2.25rem;
  }

  .nav-link {
    font-family: var(--font-mono);
    font-size: var(--font-size-mono);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--ink-2);
    position: relative;
    padding: 0.25rem 0;
  }

  .nav-link:hover,
  .nav-link.is-active {
    color: var(--ink);
  }

  .nav-link.is-active::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 1px;
    background-color: var(--brand-blue);
  }


  /* Trigger Mobile */
  .mobile-menu-trigger {
    font-family: var(--font-mono);
    font-size: var(--font-size-mono);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--ink);
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--ink);
    position: relative;
  }

  /* Área de toque de ~44px sem alterar o desenho do botão */
  .mobile-menu-trigger::after {
    content: '';
    position: absolute;
    inset: -8px -12px;
  }

  /* Overlay Mobile */
  .mobile-overlay {
    position: fixed;
    top: var(--header-height);
    left: 0;
    width: 100%;
    height: calc(100vh - var(--header-height));
    background-color: var(--paper);
    z-index: 99;
    display: flex;
    flex-direction: column;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity var(--motion-duration-base) var(--motion-ease), visibility var(--motion-duration-base);
  }

  .mobile-overlay.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .mobile-overlay-inner {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    padding-top: 2rem;
    padding-bottom: 2.5rem;
  }

  .mobile-nav-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .mobile-nav-link {
    font-family: var(--font-display);
    font-size: 2.25rem;
    line-height: 1.1;
    color: var(--ink);
    text-decoration: none;
  }

  .mobile-nav-link:hover {
    color: var(--accent);
  }


  .mobile-overlay-footer {
    padding-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
</style>

