---
---

<dialog id="project-lightbox" class="lightbox-dialog" aria-label="Visualizador de fotografias em tela cheia">
  <div class="lightbox-container">
    <!-- Barra Superior: Contador e Botão Fechar -->
    <div class="lightbox-header">
      <span class="type-mono-label lightbox-counter" data-lightbox-counter>01 / 01</span>
      <button 
        type="button" 
        class="lightbox-btn-close" 
        data-lightbox-close 
        aria-label="Fechar visualizador de fotografias"
      >
        <span class="type-mono-label">Fechar</span>
        <span class="symbol" aria-hidden="true">[×]</span>
      </button>
    </div>

    <!-- Área Principal com Imagem e Botões Laterais -->
    <div class="lightbox-main">
      <button 
        type="button" 
        class="lightbox-nav-btn btn-prev" 
        data-lightbox-prev 
        aria-label="Fotografia anterior"
      >
        <span class="arrow" aria-hidden="true">←</span>
      </button>

      <div class="lightbox-image-wrapper">
        <img 
          src="" 
          alt="" 
          class="lightbox-image" 
          data-lightbox-image 
        />
      </div>

      <button 
        type="button" 
        class="lightbox-nav-btn btn-next" 
        data-lightbox-next 
        aria-label="Próxima fotografia"
      >
        <span class="arrow" aria-hidden="true">→</span>
      </button>
    </div>

    <!-- Barra Inferior: Legenda Técnica -->
    <div class="lightbox-footer">
      <p class="type-mono-label lightbox-caption" data-lightbox-caption></p>
    </div>
  </div>
</dialog>

<script>
  import { initLightbox } from '../scripts/lightbox';

  // Inicialização no primeiro carregamento e nas transições de página
  document.addEventListener('astro:page-load', () => {
    initLightbox();
  });
</script>

<style>
  .lightbox-dialog {
    margin: auto;
    padding: 0;
    border: none;
    background: transparent;
    max-width: 100vw;
    max-height: 100vh;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .lightbox-dialog::backdrop {
    background-color: rgba(27, 26, 23, 0.94);
    backdrop-filter: blur(4px);
  }

  .lightbox-container {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--space-md);
    box-sizing: border-box;
    color: var(--paper);
  }

  /* Header */
  .lightbox-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    z-index: 10;
  }

  .lightbox-counter {
    color: var(--line);
    letter-spacing: 0.1em;
  }

  .lightbox-btn-close {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--paper);
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    transition: color var(--motion-duration-fast) ease;
  }

  .lightbox-btn-close:hover {
    color: var(--accent);
  }

  .lightbox-btn-close .symbol {
    font-family: var(--font-mono);
  }

  /* Main Stage */
  .lightbox-main {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
    width: 100%;
    height: calc(100% - 100px);
    overflow: hidden;
  }

  .lightbox-image-wrapper {
    flex: 1;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-xs);
  }

  .lightbox-image {
    max-width: 100%;
    max-height: 80vh;
    object-fit: contain;
    border-radius: 2px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
    user-select: none;
  }

  .lightbox-nav-btn {
    background: transparent;
    border: none;
    color: var(--paper);
    font-size: 1.75rem;
    padding: var(--space-md);
    cursor: pointer;
    z-index: 10;
    transition: color var(--motion-duration-fast) ease, transform var(--motion-duration-fast) ease;
  }

  .lightbox-nav-btn:hover {
    color: var(--accent);
    transform: scale(1.1);
  }

  @media (max-width: 767px) {
    .lightbox-nav-btn {
      display: none; /* No mobile a navegação é primariamente por swipe */
    }

    .lightbox-container {
      padding: var(--space-sm);
    }
  }

  /* Footer */
  .lightbox-footer {
    width: 100%;
    text-align: center;
    padding-top: var(--space-xs);
  }

  .lightbox-caption {
    color: var(--line);
    letter-spacing: 0.06em;
    max-width: 80ch;
    margin: 0 auto;
  }
</style>

