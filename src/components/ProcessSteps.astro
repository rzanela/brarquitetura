---
interface StepItem {
  number: string;
  title: string;
  description: string;
}

const steps: StepItem[] = [
  {
    number: "01",
    title: "Conversa inicial",
    description: "Alinhamento de programa, necessidades e expectativas orçamentárias, com visita técnica ao terreno ou imóvel."
  },
  {
    number: "02",
    title: "Estudo preliminar",
    description: "Definição do partido arquitetônico, volumetria, ventilação cruzada e distribuição solar em modelos tridimensionais."
  },
  {
    number: "03",
    title: "Projeto executivo",
    description: "Detalhamento construtivo completo, paginações minuciosas e compatibilização com todos os projetos de engenharia."
  },
  {
    number: "04",
    title: "Acompanhamento de obra",
    description: "Vistorias periódicas no canteiro para assegurar a conformidade material, construtiva e espacial com o projeto."
  }
];
---

<div class="process-steps-wrapper">
  <div class="grid-12 process-grid">
    {steps.map((step) => (
      <div class="col-3 process-col hairline-top">
        <div class="step-header">
          <span class="type-mono-label step-number text-accent">
            {step.number}
          </span>
        </div>

        <h3 class="step-title mt-sm">
          {step.title}
        </h3>

        <p class="step-description type-body text-ink-2 mt-xs">
          {step.description}
        </p>
      </div>
    ))}
  </div>
</div>

<style>
  .process-steps-wrapper {
    width: 100%;
  }

  .process-grid {
    row-gap: var(--space-lg);
  }

  .process-col {
    padding-top: var(--space-sm);
    display: flex;
    flex-direction: column;
  }

  @media (max-width: 900px) and (min-width: 600px) {
    .process-col {
      grid-column: span 6;
    }
  }

  @media (max-width: 599px) {
    .process-col {
      grid-column: span 12;
    }
  }

  .step-header {
    display: flex;
    align-items: baseline;
  }

  .step-number {
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
  }

  .step-title {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.8vw, 1.5rem);
    font-weight: var(--font-weight-display);
    line-height: 1.25;
    color: var(--ink);
    letter-spacing: -0.01em;
  }

  .step-description {
    font-size: 0.9375rem;
    line-height: 1.55;
  }
</style>

