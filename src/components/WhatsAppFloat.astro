---
import { buildWhatsAppUrl } from '../data/whatsapp';
import { hasWhatsApp } from '../data/site';

interface Props {
  contextOrigem?: 'geral' | 'projeto' | 'categoria' | 'pos-briefing';
  projectName?: string;
}

const { contextOrigem = 'geral', projectName } = Astro.props;

const whatsappUrl = buildWhatsAppUrl({
  origem: contextOrigem,
  projetoNome: projectName
});
---

{hasWhatsApp && (
<aside class="whatsapp-float-wrapper" aria-label="Atendimento rápido pelo WhatsApp">
  <a
    href={whatsappUrl}
    id="whatsapp-float-btn"
    class="whatsapp-float-btn"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Conversar com Borges e Robles Arquitetura pelo WhatsApp"
  >
    <!-- Ícone de traço fino (seção 3: traço fino 1.5px, sem preenchimento verde estridente) -->
    <svg 
      width="24" 
      height="24" 
      viewBox="0 0 24 24" 
      fill="none" 
      stroke="currentColor" 
      stroke-width="1.5" 
      stroke-linecap="round" 
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
      <path d="M9.5 9a1.5 1.5 0 0 0 1.5 1.5c.5 0 1-.3 1.2-.5l1.3.8c.2.2.5.2.7 0l1.3-.8c.2.2.7.5 1.2.5a1.5 1.5 0 0 0 1.5-1.5"></path>
    </svg>
  </a>
</aside>
)}

<script>
  import { initWhatsAppFloat } from '../scripts/whatsapp';

  document.addEventListener('astro:page-load', () => {
    initWhatsAppFloat();
  });
</script>

<style>
  .whatsapp-float-wrapper {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    z-index: 95;
    pointer-events: none;
  }

  /* Botão Círculo de 48px em --ink com transição sóbria (seção 7.1) */
  .whatsapp-float-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: var(--ink);
    color: var(--paper);
    text-decoration: none;
    box-shadow: 0 2px 10px rgba(20, 22, 25, 0.2);
    /* Oculto = fora do foco do teclado e da árvore de acessibilidade (visibility) */
    opacity: 0;
    visibility: hidden;
    transform: translateY(16px);
    pointer-events: none;
    transition: opacity var(--motion-duration-base) ease,
                visibility 0s linear var(--motion-duration-base),
                transform var(--motion-duration-base) cubic-bezier(0.2, 0.7, 0.2, 1),
                background-color var(--motion-duration-fast) ease,
                color var(--motion-duration-fast) ease;
  }

  .whatsapp-float-btn.is-visible {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
    transform: translateY(0);
    pointer-events: auto;
  }

  .whatsapp-float-btn:hover {
    background-color: var(--accent);
    color: var(--paper);
    transform: translateY(-2px);
  }

  @media (max-width: 767px) {
    .whatsapp-float-wrapper {
      bottom: 1.25rem;
      right: 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .whatsapp-float-btn {
      transition: opacity 0.01ms !important;
      transform: none !important;
    }
  }
</style>

